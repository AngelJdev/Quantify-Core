{
  "name": "@quantify/telemetry-simulation",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "contracts": "node scripts/generate-types.cjs",
    "build": "npm run contracts && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test --test-timeout=120000 tests/*.test.cjs",
    "start": "node dist/main.js",
    "migrate": "node scripts/migrate.cjs",
    "fixtures": "node scripts/fixtures.cjs",
    "validate:openapi": "node scripts/validate-openapi.cjs",
    "evidence": "npm run build --silent && node scripts/evidence.cjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jose": "5.10.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.6.0-beta.19",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "5.9.3"
  },
  "overrides": {
    "multer": "2.5.0"
  }
}
