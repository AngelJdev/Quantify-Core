# Cargar en la sesión; el servicio no lee .env automáticamente. Nunca registrar secretos.
TELEMETRY_SIMULATION_ENABLED=1
DATABASE_URL=
KEYCLOAK_ISSUER=http://127.0.0.1:8080/realms/quantify
KEYCLOAK_AUDIENCE=quantify-api
PORT=3035
# Proyección sintética QUANCORE-22: deshabilitada salvo opt-in explícito.
TELEMETRY_MONGODB_ENABLED=0
MONGODB_URL=
MONGODB_DATABASE=quancore22_synthetic
# QUANCORE-25: requiere vistas dashboard_read.v1_revisions y v1_check_ins.
DASHBOARD_ENABLED=0
