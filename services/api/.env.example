# Public local settings; fill DATABASE_URL privately in .env.local.
DATABASE_URL=
KEYCLOAK_ISSUER=http://localhost:8080/realms/quantify
KEYCLOAK_AUDIENCE=quantify-api
HOST=127.0.0.1
PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Explicit opt-in for the provisional D-03/04 write policy under team review.
CORE_REVIEW_WRITES_ENABLED=0
# Optional local development auto-provisioning of active OIDC profiles on first login.
CORE_AUTO_PROVISION_PROFILES=0
# Optional local Compose backchannel. Issuer/audience validation remains unchanged.
KEYCLOAK_JWKS_URL=
OBSERVABILITY_ENABLED=0
METRICS_HOST=127.0.0.1
METRICS_PORT=9464
LOKI_PUSH_URL=
# Server-only Google Gemini API settings for RF-07 conversational assistant (never expose to clients):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
