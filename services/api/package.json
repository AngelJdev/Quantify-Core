{
  "name": "@quantify/core-api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node build/src/main.js",
    "migrate": "node db/migrate.cjs",
    "test": "npm run build && node --test --test-timeout=120000 tests/*.test.cjs tests/*.test.js",
    "validate:openapi": "node telemetry/scripts/validate-openapi.cjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@prometheus-io/client": "0.16.1",
    "@types/nodemailer": "^8.0.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "express": "5.2.1",
    "jose": "5.10.0",
    "mongodb": "^7.9.1",
    "nodemailer": "^10.6.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.6.0-beta.19",
    "typescript": "5.9.3"
  },
  "overrides": {
    "multer": "2.5.0"
  }
}
