  "title": "DashboardProgress",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "window": {
      "$ref": "./common.schema.json#/$defs/window"
    },
    "closed": {
      "$ref": "./common.schema.json#/$defs/summary"
    },
