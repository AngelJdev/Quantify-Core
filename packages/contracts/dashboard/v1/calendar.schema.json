{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DashboardCalendar",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "window": {
      "$ref": "./common.schema.json#/$defs/window"
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "maxItems": 366,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "closed": {
            "$ref": "./common.schema.json#/$defs/summary"
          },
          "open": {
            "$ref": "./common.schema.json#/$defs/summary"
          },
          "futureOpportunities": {
            "type": "integer",
            "minimum": 0,
            "maximum": 183000
          }
        },
        "required": [
          "date",
          "closed",
          "open",
          "futureOpportunities"
        ]
      }
    }
  },
  "required": [
    "window",
    "days"
  ]
}
