              }
            }
          },
          "503": {
            "description": "Módulo deshabilitado, puerto de lectura ausente o datos de origen incoherentes",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../telemetry/v1/error.schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/me/dashboard/trends": {
      "get": {
        "operationId": "getOwnDashboardTrends",
        "tags": [
          "Dashboard"
        ],
        "summary": "Tendencias de cumplimiento cerrado",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          {
            "name": "habitId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          },
          {
            "name": "bucket",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "day",
                "week"
              ],
              "default": "week"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Agregado calculado desde snapshot PostgreSQL; periodos abiertos separados",
            "content": {
