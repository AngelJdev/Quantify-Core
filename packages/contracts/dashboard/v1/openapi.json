              }
            }
          },
          "401": {
            "description": "Access token inválido",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../telemetry/v1/error.schema.json"
                }
              }
            }
          },
          "403": {
            "description": "Perfil no activo",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../telemetry/v1/error.schema.json"
                }
              }
            }
          },
          "404": {
            "description": "Hábito propio no encontrado",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../telemetry/v1/error.schema.json"
                }
              }
            }
          },
          "503": {
            "description": "Módulo deshabilitado, puerto de lectura ausente o datos de origen incoherentes",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../telemetry/v1/error.schema.json"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
