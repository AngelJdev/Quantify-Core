        "tags": [
          "TelemetrySimulation"
        ],
        "responses": {
          "201": {
            "description": "Fuente registrada o ya existente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./source-state.schema.json"
                }
              }
            }
          },
          "400": {
            "description": "JSON o parámetro inválido",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./error.schema.json"
                }
              }
            }
          },
          "401": {
            "description": "Access token ausente o inválido",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./error.schema.json"
                }
              }
            }
          },
          "403": {
            "description": "Perfil/fuente/consentimiento no vigente",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./error.schema.json"
                }
              }
            }
          },
          "404": {
            "description": "Recurso propio no encontrado",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./error.schema.json"
                }
              }
            }
          },
          "409": {
            "description": "Conflicto de versión, lote o muestra",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./error.schema.json"
                }
              }
            }
          },
          "413": {
            "description": "Cuerpo mayor a 64 KiB",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./error.schema.json"
                }
              }
            }
          },
          "422": {
            "description": "Esquema, unidad, valor o instante inválido",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./error.schema.json"
                }
              }
            }
          },
          "503": {
            "description": "Dependencia no disponible; no confirmar recepción",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./error.schema.json"
