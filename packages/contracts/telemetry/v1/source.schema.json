{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quantify:telemetry:simulation:1:source",
  "title": "SyntheticSource",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sourceId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "origin": {
      "const": "synthetic-generator"
    },
    "schemaVersion": {
      "const": "1.0.0"
    }
  },
  "required": [
    "sourceId",
    "origin",
    "schemaVersion"
  ]
}
