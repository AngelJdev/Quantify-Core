# Generated privately by node scripts/dev-base.mjs init. Never commit values.
POSTGRES_PASSWORD=
CORE_RUNTIME_PASSWORD=
KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=
CORE_REVIEW_WRITES_ENABLED=0
# Opcional en Windows si Hyper-V/winnat excluye 55432 tras reiniciar:
# POSTGRES_HOST_PORT=55432
# Opcional para habilitar acceso con Google en Keycloak (configure-mobile-identity.mjs):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional para habilitar el asistente conversacional Gemini en services/api (solo servidor):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
