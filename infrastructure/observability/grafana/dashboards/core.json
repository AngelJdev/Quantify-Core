{
  "uid": "core-local",
  "title": "Quantify Core - local review",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "timezone": "utc",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "local-review"
  ],
  "panels": [
    {
      "id": 1,
      "title": "API disponible",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-core"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"core-api\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Sin datos"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "SQL listo",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-core"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quantify_core_ready"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Sin datos"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Solicitudes / segundo",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-core"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(quantify_http_requests_total[1m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Sin datos"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Errores 5xx / segundo",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-core"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(quantify_http_requests_total{status_class=\"5xx\"}[1m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Sin datos"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Latencia p95 (segundos)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-core"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by (le)(rate(quantify_http_request_duration_seconds_bucket[2m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Sin datos"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Memoria RSS (bytes)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-core"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Sin datos"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Logs descartados",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-core"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quantify_operational_logs_dropped_total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Sin datos"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "Logs operativos minimizados",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki-core"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=\"api\",environment=\"local-review\"}"
        }
      ]
    }
  ]
}