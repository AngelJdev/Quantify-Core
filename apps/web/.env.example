# Configuración pública del cliente web Quantify
# Nota: Vite expone solo las variables con prefijo VITE_ al navegador. No incluir secretos.

VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_OIDC_ISSUER=http://localhost:8080/realms/quantify
VITE_OIDC_CLIENT_ID=quantify-web
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback

