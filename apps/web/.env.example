# Public build-time values only. No credentials or tokens.
# Example after confirming API routing/CORS: http://localhost:3000/api/v1
VITE_API_BASE_URL=
# Relative to the API base, no initial slash. Leave empty until the route exists.
# Existing core NestJS: health/ready or health/live. There is no /health alias.
VITE_API_HEALTH_PATH=
# ADR-0007 local read-only flow: http://localhost:8180/realms/quantify
VITE_OIDC_ISSUER=
# Existing public client: quantify-web. No client secret.
VITE_OIDC_CLIENT_ID=
